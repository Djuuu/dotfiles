[submodule "lib/dotbot"]
	path = lib/dotbot
	url = https://github.com/anishathalye/dotbot.git

[submodule "lib/dotbot-apt"]
	path = lib/dotbot-apt
	url = https://github.com/bryant1410/dotbot-apt
[submodule "lib/dotbot-sudo"]
	path = lib/dotbot-sudo
	#url = https://github.com/DrDynamic/dotbot-sudo.git   # upstream
	url = https://github.com/mskyaxl/dotbot-sudo.git      # mskyaxl
	#url = https://github.com/johnlettman/dotbot-sudo.git # johnlettman
[submodule "lib/dotbot-winget"]
	path = lib/dotbot-winget
	url = https://github.com/zknx/dotbot-winget.git

[submodule "config/AutoHotkey"]
	path = config/AutoHotkey
	url = https://github.com/Djuuu/AutoHotkey.git

[submodule "config/tmux/plugins/catppuccin-tmux"]
	path = config/tmux/plugins/catppuccin-tmux
	url = https://github.com/catppuccin/tmux.git
[submodule "config/tmux/plugins/tmux-git-status"]
	path = config/tmux/plugins/tmux-git-status
	url = https://github.com/Djuuu/tmux-git-status.git
[submodule "config/tmux/plugins/tpm"]
	path = config/tmux/plugins/tpm
	url = https://github.com/tmux-plugins/tpm.git

[submodule "lib/mu-repo"]
	path = lib/mu-repo
	url = https://github.com/fabioz/mu-repo.git

[submodule "lib/dockerize-clis"]
	path = lib/dockerize-clis
	url = https://github.com/Djuuu/dockerize-clis.git
[submodule "lib/forgit"]
	path = lib/forgit
	url = https://github.com/Djuuu/forgit.git
