# ~/.dotfiles/.bashrc.env: environment for every bash shell (login or not, interactive or not).
# Must stay silent (any output breaks scp/rsync/sftp) and idempotent (tmux starts a login shell in every pane).

# Set XDG defaults
# https://specifications.freedesktop.org/basedir/latest/
# https://wiki.archlinux.org/title/XDG_Base_Directory
export XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}   # user-specific data files
export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}    # user-specific configuration files
export XDG_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state} # user-specific state files
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}       # user-specific non-essential data files
export XDG_BIN_HOME=${XDG_BIN_HOME:-$HOME/.local/bin}       # user-specific executable files (non-standard var)

# Add an existing directory to a colon-separated path variable.
# usage: path_add <var> <dir> [append]
path_add() {
    [ -d "$2" ] || return 0 # exit if directory does not exist...
    case ":${!1}:" in *":$2:"*) return 0 ;; esac # ...or is already in path.
    if [ -n "$3" ]
        then export "$1=${!1}:$2" # append
        else export "$1=$2:${!1}" # prepend
    fi
}

# Add go/bin to PATH
path_add PATH "/usr/local/go/bin" append

# Set PATH so it includes user's bin/ directories
path_add PATH ~/go/bin
path_add PATH "${XDG_DATA_HOME}/go/bin"
path_add PATH "${XDG_BIN_HOME}"

# Set MANPATH & INFOPATH so it includes users' private man & info
path_add MANPATH ~/man
path_add INFOPATH ~/info

# Editor
export EDITOR="vim"
export VISUAL="vim"

# Ansible
export ANSIBLE_HOME="${XDG_DATA_HOME}/ansible"
#export ANSIBLE_CONFIG="${XDG_CONFIG_HOME}/ansible.cfg"
export ANSIBLE_GALAXY_CACHE_DIR="${XDG_CACHE_HOME}/ansible/galaxy_cache"

# fzf
export FZF_DEFAULT_OPTS="--style full"
export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always {}'"
export FZF_CTRL_R_OPTS="--layout=reverse"

# Gnupg
export GNUPGHOME="${XDG_DATA_HOME}/gnupg"

# Go
export GOPATH="${XDG_DATA_HOME}/go"

# Vim
export VIMINIT="source ${XDG_CONFIG_HOME}/vim/vimrc"
#export VIMINIT="if has('nvim') | source ${XDG_CONFIG_HOME}/nvim/init.vim
#                else           | source ${XDG_CONFIG_HOME}/vim/vimrc | endif"

# Local environment overrides
# shellcheck source=.bashrc.env.local
[ -f ~/.dotfiles/.bashrc.env.local ] && . ~/.dotfiles/.bashrc.env.local
